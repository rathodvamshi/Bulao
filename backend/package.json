{
  "name": "@bulao/backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node ../scripts/remote-api-only.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply DB --remote --env staging",
    "db:generate": "drizzle-kit generate",
    "deploy:staging": "wrangler deploy --env staging"
  },
  "dependencies": {
    "@bulao/domain": "workspace:*",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250906.0",
    "drizzle-kit": "^0.31.4",
    "wrangler": "^4.34.0",
    "vitest": "^3.2.4",
    "@cloudflare/vitest-pool-workers": "^0.8.69"
  }
}
